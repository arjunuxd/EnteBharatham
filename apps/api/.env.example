# EnteBharatham API — local development configuration.
# Copy this file to .env and adjust values. NEVER commit the real .env file.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# MongoDB connection string (local MongoDB Community Server or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/entebharatham

# Comma-separated CORS allowlist (frontend origins permitted to call the API).
# "*" is allowed for local development only; it is rejected in production.
# Explicit origins enable credentialed requests (cookies); "*" disables them.
API_CORS_ORIGINS=http://localhost:5173

# Secret used to sign session cookies and CSRF tokens. A fixed development
# default is used when unset; production rejects the default and requires a
# unique value of at least 32 characters.
SESSION_SECRET=entebharatham-development-session-secret-do-not-use-in-production

# SameSite policy for the session cookie: lax | strict | none.
# "none" requires Secure (production) and is only for cross-site deployments
# (e.g. a Vercel frontend calling a Render API on another domain).
SESSION_COOKIE_SAMESITE=lax

# Session lifetime in hours (default: 168 = 7 days).
SESSION_MAX_AGE_HOURS=168

# Number of trusted reverse-proxy hops in front of the API (0 = none). Set to 1
# when deployed behind a single proxy (Render, nginx) so rate limiting and
# secure-cookie logic see the real client IP.
TRUST_PROXY_HOPS=0

# Email delivery
EMAIL_PROVIDER=dev
EMAIL_FROM=noreply@localhost
APP_BASE_URL=http://localhost:5173

# Rate limiting shared store
RATE_LIMIT_STORE=memory
# # Use RATE_LIMIT_STORE=mongo in production (shared across instances).
# REDIS_URL is not supported.

# Media storage
STORAGE_PROVIDER=local
MEDIA_UPLOAD_DIR=uploads
MEDIA_MAX_SIZE_BYTES=10485760
MEDIA_MAX_COUNT_PER_RECORD=10

# --- Admin bootstrap (npm run bootstrap:admin -w @entebharatham/api) ---
# Used only by the one-time CLI bootstrap; never read by the HTTP server.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-a-long-unique-password
# ADMIN_DISPLAY_NAME=Site Administrator
# ADMIN_ROLE=admin

# SMTP (required in production): SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE, SMTP_REQUIRE_TLS, SMTP_REJECT_UNAUTHORIZED (must remain true)
# S3 (required in production): S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_ENDPOINT, S3_FORCE_PATH_STYLE, S3_PREFIX
# Run index sync in production: npm run db:indexes -w @entebharatham/api

