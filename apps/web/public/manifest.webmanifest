{
  "id": "/",
  "name": "EnteBharatham — India's Living Heritage Archive",
  "short_name": "EnteBharatham",
  "description": "A community-powered archive of India's folk stories, oral histories, songs, recipes, proverbs, languages, customs, and crafts.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
